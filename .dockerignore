# Everything listed here is NOT sent to the Docker daemon as build context:
# smaller, faster builds, and no local secrets or stale build output inside the image.
# (Patterns are relative to the repo root: "**/target" also covers every service's target folder.)
**/target
.git/
.idea/
**/*.iml
.vscode/
.github/
.env
HELP.md
README.md
config-repo/
scripts/
docker-compose.yml
